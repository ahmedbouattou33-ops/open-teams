NODE_ENV=development
PORT=4003

# Must match JWT_ISSUER + public key of mcp-auth-workspace
JWT_ACCESS_PUBLIC_KEY_PATH=./keys/access-public.pem
JWT_ISSUER=openteams:mcp-auth-workspace

# Where to verify channel membership / RBAC
AUTH_SERVICE_URL=http://localhost:4001
INTERNAL_API_KEY=change-me-min-16-chars
