NODE_ENV=development
PORT=4002

# Messaging owns a dedicated database (microservice isolation).
DATABASE_URL="postgresql://openteams:openteams@localhost:5432/openteams_messaging?schema=public"

# Must match JWT_ISSUER + public key of mcp-auth-workspace
JWT_ACCESS_PUBLIC_KEY_PATH=./keys/access-public.pem
JWT_ISSUER=openteams:mcp-auth-workspace

# Where to verify channel membership / RBAC
AUTH_SERVICE_URL=http://localhost:4001
INTERNAL_API_KEY=dev-internal-secret-change-me

# Optional Redis Pub/Sub fan-out (single-instance broadcast works without it)
REDIS_URL=redis://localhost:6379
