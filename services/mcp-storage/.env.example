NODE_ENV=development
PORT=4004

# Storage owns a dedicated database (microservice isolation).
DATABASE_URL="postgresql://openteams:openteams@localhost:5432/openteams_storage?schema=public"

# Must match JWT_ISSUER + public key of mcp-auth-workspace
JWT_ACCESS_PUBLIC_KEY_PATH=./keys/access-public.pem
JWT_ISSUER=openteams:mcp-auth-workspace

# Where to verify channel membership / RBAC
AUTH_SERVICE_URL=http://localhost:4001
INTERNAL_API_KEY=change-me-min-16-chars

# S3 / MinIO backend (forcePathStyle is enabled automatically)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=openteams-files
