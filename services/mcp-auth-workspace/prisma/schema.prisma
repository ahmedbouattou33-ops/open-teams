// OpenTeams — mcp-auth-workspace data model
// RBAC hierarchy: OWNER > ADMIN > MEMBER > GUEST

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  // Per-service output avoids the pnpm shared-store clash between services.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ONLINE
  OFFLINE
  AWAY
  DND
}

enum ChannelType {
  PUBLIC
  PRIVATE
  DIRECT
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String
  displayName       String
  avatarUrl         String?
  identityPublicKey String? // base64 X25519 SPKI — published for E2EE DM sessions
  status            UserStatus @default(OFFLINE)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  refreshTokens    RefreshToken[]
  workspaceMembers WorkspaceMember[]
  channelMembers   ChannelMember[]
  ownedWorkspaces  Workspace[]
  agendaEvents     AgendaEvent[]
  personalNotes    PersonalNote[]
  eventParticipants EventParticipant[]
  noteShares       NoteShare[]
  assignedTasks    WorkTask[] @relation("assignedTasks")
  createdTasks     WorkTask[] @relation("createdTasks")
  teamTools        TeamTool[]
  sentInvites      WorkspaceInvite[] @relation("sentInvites")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // sha256 of the opaque token
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  WorkspaceMember[]
  channels Channel[]
  agendaEvents AgendaEvent[]
  personalNotes PersonalNote[]
  workTasks WorkTask[]
  teamTools TeamTool[]
  invites WorkspaceInvite[]
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        MemberRole @default(MEMBER)
  createdAt   DateTime   @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Channel {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  type        ChannelType @default(PUBLIC)
  isEncrypted Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  members ChannelMember[]

  @@unique([workspaceId, name])
}

model ChannelMember {
  id        String     @id @default(cuid())
  channelId String
  channel   Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MemberRole @default(MEMBER)
  createdAt DateTime   @default(now())

  @@unique([channelId, userId])
  @@index([userId])
}


enum AgendaVisibility {
  PRIVATE
  SHARED
  WORKSPACE
}

enum AgendaPermission {
  VIEW
  EDIT
}

model AgendaEvent {
  id          String           @id @default(cuid())
  ownerId     String
  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  timezone    String           @default("UTC")
  visibility  AgendaVisibility @default(PRIVATE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  participants EventParticipant[]
  notes        PersonalNote[]

  @@index([ownerId, startsAt])
  @@index([workspaceId, startsAt])
}

model EventParticipant {
  id         String           @id @default(cuid())
  eventId    String
  event      AgendaEvent      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission AgendaPermission @default(VIEW)
  accepted   Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

model PersonalNote {
  id          String        @id @default(cuid())
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  eventId     String?
  event       AgendaEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  content     String
  isPrivate   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  shares NoteShare[]

  @@index([ownerId, updatedAt])
  @@index([workspaceId, updatedAt])
}


model NoteShare {
  id         String           @id @default(cuid())
  noteId     String
  note       PersonalNote     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission AgendaPermission @default(VIEW)
  createdAt  DateTime         @default(now())

  @@unique([noteId, userId])
  @@index([userId])
}


enum WorkTaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum WorkTaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model WorkTask {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     User           @relation("createdTasks", fields: [creatorId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?          @relation("assignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  title       String
  description String?
  status      WorkTaskStatus @default(BACKLOG)
  priority    WorkTaskPriority @default(MEDIUM)
  dueAt       DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([workspaceId, status])
  @@index([assigneeId, status])
  @@index([workspaceId, dueAt])
}

model TeamTool {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  url         String?
  enabled     Boolean   @default(true)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId, enabled])
}


enum WorkspaceInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model WorkspaceInvite {
  id            String                @id @default(cuid())
  workspaceId   String
  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviterUserId String
  inviter       User                  @relation("sentInvites", fields: [inviterUserId], references: [id], onDelete: Cascade)
  inviteeEmail  String?
  code          String                @unique
  role          MemberRole            @default(MEMBER)
  status        WorkspaceInviteStatus @default(PENDING)
  maxUses       Int?
  useCount      Int                   @default(0)
  expiresAt     DateTime
  createdAt     DateTime              @default(now())

  @@index([workspaceId, status])
  @@index([inviteeEmail, status])
  @@index([expiresAt])
}
