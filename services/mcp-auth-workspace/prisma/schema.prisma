// OpenTeams — mcp-auth-workspace data model
// RBAC hierarchy: OWNER > ADMIN > MEMBER > GUEST

generator client {
  provider = "prisma-client-js"
  // Per-service output avoids the pnpm shared-store clash between services.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ONLINE
  OFFLINE
  AWAY
  DND
}

enum ChannelType {
  PUBLIC
  PRIVATE
  DIRECT
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String
  displayName       String
  avatarUrl         String?
  identityPublicKey String? // base64 X25519 SPKI — published for E2EE DM sessions
  status            UserStatus @default(OFFLINE)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  refreshTokens    RefreshToken[]
  workspaceMembers WorkspaceMember[]
  channelMembers   ChannelMember[]
  ownedWorkspaces  Workspace[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // sha256 of the opaque token
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  WorkspaceMember[]
  channels Channel[]
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        MemberRole @default(MEMBER)
  createdAt   DateTime   @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Channel {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  type        ChannelType @default(PUBLIC)
  isEncrypted Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  members ChannelMember[]

  @@unique([workspaceId, name])
}

model ChannelMember {
  id        String     @id @default(cuid())
  channelId String
  channel   Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MemberRole @default(MEMBER)
  createdAt DateTime   @default(now())

  @@unique([channelId, userId])
  @@index([userId])
}
