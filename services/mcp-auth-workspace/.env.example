NODE_ENV=development
PORT=4001
DATABASE_URL="postgresql://openteams:openteams@localhost:5432/openteams?schema=public"

# RS256 signing keys generated via `pnpm gen:keys` (paths resolved from this service directory)
JWT_ACCESS_PRIVATE_KEY_PATH=./keys/access-private.pem
JWT_ACCESS_PUBLIC_KEY_PATH=./keys/access-public.pem
JWT_ACCESS_TTL=15m
JWT_ISSUER=openteams:mcp-auth-workspace

REFRESH_TOKEN_TTL_DAYS=30

# Shared secret consumed by mcp-messaging / mcp-media-rtc / mcp-storage (min 16 chars)
INTERNAL_API_KEY=dev-internal-secret-change-me

# Browser origins allowed by CORS (comma-separated)
CORS_ORIGIN=http://localhost:3000
