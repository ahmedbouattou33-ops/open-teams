{
  "name": "openteams",
  "private": true,
  "version": "0.1.0",
  "description": "Enterprise-grade open-source alternative to Microsoft Teams. Modular microservices monorepo powered by MCP servers with E2EE support.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev:auth": "turbo run dev --filter=@openteams/mcp-auth-workspace",
    "dev:messaging": "turbo run dev --filter=@openteams/mcp-messaging",
    "dev:storage": "turbo run dev --filter=@openteams/mcp-storage",
    "db:migrate": "turbo run db:migrate --filter=@openteams/mcp-auth-workspace",
    "db:push": "turbo run db:push",
    "db:generate": "turbo run db:generate",
    "gen:keys": "node services/mcp-auth-workspace/scripts/generate-keys.mjs",
    "test:security:static": "node scripts/security-static-audit.mjs",
    "test:security:jwt": "pnpm --filter @openteams/mcp-auth-workspace build && node scripts/jwt-unit-proof.mjs",
    "test:security:runtime": "node scripts/security-proof.mjs",
    "test:security:member-joined": "pnpm --filter @openteams/mcp-messaging build && node scripts/member-joined-unit-proof.mjs",
    "test:security:member-joined:integration": "pnpm --filter @openteams/mcp-messaging build && node scripts/member-joined-integration-proof.mjs",
    "test:e2e:full": "playwright test scripts/e2e-full-coverage.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
